{
  "expo": {
    "name": "BheemAI",
    "slug": "bheemai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bheemai_app_icon_1024.png",
    "scheme": "bheemai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pushpendra.bheemai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pushpendra.bheemai",
      "android": {
  "package": "com.pushpendra.bheemai",
  "edgeToEdgeEnabled": true,
  "predictiveBackGestureEnabled": false
},
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bheemai_splash_1242x2688.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0B",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cab97e4-3efa-4187-8009-8101b556be77"
      }
    }
  }
}
