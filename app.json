{
  "expo": {
    "name": "BheemAI",
    "slug": "atlas3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bheemai_app_icon_1024.png",
    "scheme": "atlas3",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bheemai_splash_1242x2688.png",
          "imageWidth": 350,
          "resizeMode": "contain",
          "backgroundColor": "#080808",
          "dark": {
            "backgroundColor": "#080808"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}